# Backend API (gompa-tour-api). API_ACCESS_KEY must match the API server env.
API_ACCESS_KEY=
API_URL=

# NextAuth — required in production (AUTH_SECRET). Google sign-in for CMS admins.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://neykor.net

# Public image CDN base (optional; defaults in code if unset)
IMAGE_BASE_URL=
NEXT_PUBLIC_IMAGE_BASE_URL=

PORT=10000
RESEND_API_KEY=